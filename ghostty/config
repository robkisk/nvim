command = /bin/zsh
click-repeat-interval = 500
auto-update-channel = stable
font-family = "OperatorMonoSSmLig Nerd Font Book"
font-family-bold = "OperatorMonoSSmLig Nerd Font Bold"
font-family-italic = "OperatorMonoSSmLig Nerd Font Italic"
font-family-bold-italic = "OperatorMonoSSmLig Nerd Font Bold Italic"
theme = "kanagawabones"
font-size = 16
background-image="/Users/robby.kiskanyan/Pictures/databricks-logo-color.png"
background-image-fit = contain
cursor-style = underline
shell-integration-features = no-cursor
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
unfocused-split-opacity = 1
maximize = true
desktop-notifications = true
keybind = shift+enter=text:\x1b\r
keybind = ctrl+shift+d=text:\x1bD
keybind = global:ctrl+grave_accent=toggle_quick_terminal
background-image-opacity = 0.2
background-opacity = 0.7
macos-option-as-alt = true
